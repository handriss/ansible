# -- Layout Settings --

# default layout for spaces (bsp, stack or float)
yabai -m config layout bsp

# make space 9 floating by default
yabai -m config --space 9 layout float

# automatically balance windows in a space
yabai -m config auto_balance on

# spacing between windows
yabai -m config window_gap 10

# show borders around windows
yabai -m config window_border on
yabai -m config window_border_width 2
yabai -m config window_border_color 0xff505050
yabai -m config active_window_border_color 0xfff0a000

# show window shadows only for floating windows
yabai -m config window_shadow float

# animation duration for window/space transitions (0 = instant)
yabai -m config transition_duration 0

# -- Mouse Settings --

# when a window is dropped in the center of another window, swap them
# on edges, split the window
yabai -m config mouse_drop_action swap

# -- Rules --

# prevent yabai from managing certain windows
yabai -m rule --add app="^System Settings$" manage=off
yabai -m rule --add app="^Terminal$" manage=off
