<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.codeman.web</string>

  <key>ProgramArguments</key>
  <array>
    <string>{{ ansible_env.HOME }}/.nvm/versions/node/v22.21.1/bin/node</string>
    <string>{{ ansible_env.HOME }}/Projects/codeman/dist/index.js</string>
    <string>web</string>
    <string>--port</string>
    <string>3300</string>
  </array>

  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>

  <!-- launchd does not inherit a shell PATH; tmux and claude live in /opt/homebrew/bin -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:{{ ansible_env.HOME }}/.nvm/versions/node/v22.21.1/bin</string>
  </dict>

  <key>StandardOutPath</key>
  <string>/tmp/codeman.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/codeman.log</string>
</dict>
</plist>
