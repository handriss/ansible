{
  "model": "claude-fable-5",
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": true
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "voiceEnabled": true,
  "statusLine": {
    "type": "command",
    "command": "{{ ansible_env.HOME }}/.claude/status-usage.sh"
  }
}
